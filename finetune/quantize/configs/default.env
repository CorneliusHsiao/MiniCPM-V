# Shared configuration for the quantization pipeline. Sourced by run_all.sh.
# Override any of these inline, e.g.  CUDA_DEVICES=1 bash quantize/run_all.sh

# Which GPU(s) to use (maps to CUDA_VISIBLE_DEVICES for every step).
CUDA_DEVICES=0

# Model / data.
BASE_MODEL="openbmb/MiniCPM-o-2_6"
CHECKPOINT="output/output_minicpmv26/checkpoint-10000"
TRAIN_DATA="/wekafs/ict/hanyuanx/MiniCPM-V/SCRIPTS/dg_pairs_minicpm_train.json"
EVAL_DATA="/wekafs/ict/hanyuanx/MiniCPM-V/SCRIPTS/dg_pairs_minicpm_eval.json"

# Output layout (under finetune/).
ARTIFACT_DIR="quantize/artifacts"
PRED_DIR="quantize/preds"
RES_DIR="quantize/results"

# Eval size (-1 = full set) and multimodal slicing (must match training).
NUM_SAMPLES=1000
MAX_SLICE_NUMS=1

# Calibration (B1/B2) and QLoRA (C1).
NUM_CALIB_SAMPLES=256
CALIB_MAX_LENGTH=1024
QLORA_MAX_STEPS=2000
